---
import type { Project } from '@/data/projects';

interface Props {
  project: Project;
  index: number;
  tone?: 'acid' | 'lilac' | 'flame' | 'sky' | 'paper' | 'slate';
  class?: string;
  [key: `data-${string}`]: string | boolean | undefined;
}
const { project, index, tone = 'paper', class: className, ...rest } = Astro.props;
const href = project.live ?? project.source;
const tones = {
  acid: 'bg-acid text-ink',
  lilac: 'bg-lilac text-ink',
  flame: 'bg-flame text-ink',
  sky: 'bg-sky text-ink',
  paper: 'bg-paper text-ink',
  slate: 'bg-slate-600 text-paper',
};
---

<article
  class:list={['group card flex h-[90%] flex-col overflow-hidden transition-shadow duration-500 hover:shadow-[12px_12px_0_0_var(--color-ink)]', tones[tone], className]}
  style="--mx: 50%; --my: 50%;"
  data-tilt
  {...rest}
>
  <div class="flex items-center justify-between border-b-2 border-ink px-4 py-2.5 font-mono text-xs">
    <span>{String(index + 1).padStart(2, '0')} / {project.category}</span>
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="size-3 border-2 border-ink bg-flame"></span>
      <span class="size-3 border-2 border-ink bg-acid"></span>
      <span class="size-3 border-2 border-ink bg-paper"></span>
    </span>
  </div>

  <a href={href} target="_blank" rel="noopener" class="relative block overflow-hidden border-b-2 border-ink bg-ink" data-cursor={project.live ? 'Visit' : 'Code'} tabindex="-1" aria-hidden="true">
    <img
      src={project.image}
      alt=""
      loading="lazy"
      decoding="async"
      class="[aspect-ratio:16_/_10] w-full bg-ink object-contain object-center grayscale-[35%] transition-[transform,filter] duration-[1.2s] ease-[var(--ease-out-expo)] group-hover:scale-[1.03] group-hover:grayscale-0"
    />
    <span class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_var(--mx,50%)_var(--my,50%),rgba(215,255,62,0.25),transparent_45%)] opacity-0 transition-opacity duration-500 group-hover:opacity-100"></span>
  </a>

  <div class="flex flex-1 flex-col gap-4 p-5 sm:p-6">
    <h3 class="text-3xl leading-none font-bold tracking-[-0.04em] sm:text-4xl">
      {href ? <a href={href} target="_blank" rel="noopener" class="link-u">{project.title}</a> : project.title}
    </h3>
    <p class="text-[15px] leading-relaxed opacity-80">{project.summary}</p>
    <ul class="mt-auto flex flex-wrap gap-2 pt-2">
      {project.stack.map((s) => <li class="border-2 border-current px-2 py-0.5 font-mono text-[11px] font-medium">{s}</li>)}
    </ul>
    <div class="flex gap-4 border-t-2 border-current/20 pt-4 font-mono text-xs font-bold uppercase">
      {project.live && <a href={project.live} target="_blank" rel="noopener" class="link-u">Live ↗</a>}
      {project.source && <a href={project.source} target="_blank" rel="noopener" class="link-u">Source ↗</a>}
    </div>
  </div>
</article>
