<header class="relative z-40" transition:persist="header" data-header>
  <div class="container-x flex h-20 items-center justify-between gap-6 lg:h-24">
    <a href="/" class="group flex items-baseline text-3xl font-medium tracking-tight lg:text-[2.35rem]" aria-label="Miracle Jude home" data-cursor="Home">
      <span>Mira</span><span class="relative inline-block text-transparent [-webkit-text-stroke:1.5px_var(--color-paper)] transition-colors duration-500 group-hover:text-acid group-hover:[-webkit-text-stroke:1.5px_var(--color-acid)]">c</span><span>le</span><span class="ml-0.5 inline-block size-2.5 -translate-y-0.5 bg-acid transition-transform duration-500 group-hover:rotate-45 lg:size-3"></span>
    </a>

    <div class="flex items-center gap-3">
      <a href="/#contact" class="btn btn-ghost hidden py-3! md:inline-flex" data-magnetic data-cursor="Say hi">
        Let's talk
        <span class="inline-block size-2 animate-pulse rounded-full bg-acid"></span>
      </a>
      <button
        type="button"
        class="grid size-12 place-items-center border-2 border-ink bg-acid text-ink shadow-(--shadow-brutal-sm) lg:hidden"
        data-menu-open
        aria-label="Open menu"
        aria-controls="site-menu"
        aria-expanded="false"
      >
        <span class="flex w-6 flex-col items-end gap-1.25" aria-hidden="true">
          <span class="h-0.5 w-6 bg-ink"></span>
          <span class="h-0.5 w-4 bg-ink"></span>
          <span class="h-0.5 w-2.5 bg-ink"></span>
        </span>
      </button>
    </div>
  </div>
</header>
