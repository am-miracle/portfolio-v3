<div class="pointer-events-none fixed top-0 left-0 z-180 hidden" transition:persist="cursor" data-cursor-root aria-hidden="true">
  <div class="absolute -top-1 -left-1 size-2 bg-acid" data-cursor-dot></div>
  <div
    class="absolute top-0 left-0 grid size-10 -translate-x-1/2 -translate-y-1/2 place-items-center border-2 border-acid"
    data-cursor-ring
  >
    <span class="label tf-s0 text-[10px] whitespace-nowrap text-ink" data-cursor-label></span>
  </div>
</div>
