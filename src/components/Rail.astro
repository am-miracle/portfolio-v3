---
import { socials } from '@/data/site';
const railSocials = socials.slice(0, 3);
---

<aside
  class="fixed inset-y-0 left-0 z-50 hidden w-(--rail) flex-col border-r border-paper/10 bg-slate-700/40 backdrop-blur-md lg:flex"
  transition:persist="rail"
  aria-label="Site rail"
>
  <button
    type="button"
    class="group grid aspect-square w-full place-items-center border-b-2 border-ink bg-slate-500 transition-colors hover:bg-acid"
    data-menu-open
    data-cursor="Menu"
    aria-label="Open menu"
    aria-controls="site-menu"
    aria-expanded="false"
  >
    <span class="flex w-7 flex-col items-end gap-1.5" aria-hidden="true">
      <span class="h-0.5 w-7 bg-paper transition-all duration-500 group-hover:w-4 group-hover:bg-ink"></span>
      <span class="h-0.5 w-5 bg-paper transition-all duration-500 group-hover:w-7 group-hover:bg-ink"></span>
      <span class="h-0.5 w-3 bg-paper transition-all duration-500 group-hover:w-5 group-hover:bg-ink"></span>
    </span>
  </button>

  <div class="relative mx-auto mt-10 w-0.5 flex-1 bg-paper/10" aria-hidden="true">
    <div class="absolute inset-x-0 top-0 h-full origin-top tf-sy0 bg-acid" data-scroll-progress></div>
    <span
      class="label absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 -rotate-90 bg-slate-600 px-2 whitespace-nowrap text-paper/60"
      data-scroll-percent>000</span
    >
  </div>

  <ul class="flex flex-col items-center gap-10 py-12">
    {
      railSocials.map((s) => (
        <li>
          <a
            href={s.href}
            target="_blank"
            rel="noopener"
            class="block -rotate-90 text-lg font-semibold text-paper/50 transition-colors hover:text-acid"
            aria-label={s.label}
            data-cursor={s.label}
          >
            {s.short}
          </a>
        </li>
      ))
    }
  </ul>
</aside>
